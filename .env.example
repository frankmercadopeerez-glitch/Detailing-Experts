# ImageKit: server-only private key. Free account; no Firebase Storage needed.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# Maximum actual stored bytes across this portal (default 2 GB, below plan quota).
PHOTO_STORAGE_BUDGET_BYTES=2000000000

# SMS requires Blaze; keep disabled on Spark.
VITE_PHONE_AUTH_ENABLED=false
