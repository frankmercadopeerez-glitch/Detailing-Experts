# Web configuration is public. Populate ONLY after verifying Cristian's project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Server-only. Never prefix these with VITE_. Prefer workload identity in deployment.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
APP_ORIGIN=https://detailing-experts.vercel.app
REQUIRE_APP_CHECK=true
PAYMENTS_ENABLED=false
WOMPI_ENV=test
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
CRON_SECRET=
